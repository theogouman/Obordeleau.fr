# ---------------------------------------------------------------------------
# Obordeleau.fr, Phase 1 environment
# Copy to .env.local for local development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.obordeleau.fr

# --- Google Maps (consent gated, loaded only after the visitor accepts) ------
# Restrict the key to the site domain AND to "Maps JavaScript API" only.
# Set a hard daily quota (about 300/day) so usage stays under the free cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Vector Map ID carrying the brand cloud styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Direct inquiry email (Resend free tier) --------------------------------
RESEND_API_KEY=
# Where guest inquiries are delivered (the host inbox).
INQUIRY_TO_EMAIL=
# Verified sender on the Resend account, for example "Obordeleau <site@obordeleau.fr>".
INQUIRY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Phase 2, booking calendar and iCal sync
# ---------------------------------------------------------------------------

# Availability store. Server side only: the service role key bypasses RLS, so it
# must never carry a NEXT_PUBLIC_ prefix. Project settings, API, in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random path segment for the public feed served at
# /api/calendar/<ICAL_FEED_TOKEN>.ics, the single URL pasted into Airbnb and
# into Booking. Rotating it invalidates the URL both platforms hold.
ICAL_FEED_TOKEN=

# Where a direct booking is announced. Falls back to INQUIRY_TO_EMAIL.
BOOKINGS_TO_EMAIL=

# Direct Postgres connection, used only by `npm run test:sql`. Never read by
# the application: the site talks to PostgREST with the two keys above.
SUPABASE_DB_URL=

# Not an environment variable: the Airbnb export URL is a row in `ical_sources`,
# so adding Booking later is an insert rather than a deploy. The secret shared
# by the pg_cron schedule and the sync-ical Edge Function lives in the database
# too, in `sync_config`; setting SYNC_SECRET on the Edge Function overrides it.

# ---------------------------------------------------------------------------
# Phase 3 (parked, not used by this build)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
