# ---------------------------------------------------------------------------
# Obordeleau.fr, Phase 1 environment
# Copy to .env.local for local development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.obordeleau.fr

# --- Google Maps (consent gated, loaded only after the visitor accepts) ------
# Restrict the key to the site domain AND to "Maps JavaScript API" only.
# Set a hard daily quota (about 300/day) so usage stays under the free cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Vector Map ID carrying the brand cloud styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Direct inquiry email (Resend free tier) --------------------------------
RESEND_API_KEY=
# Where guest inquiries are delivered (the host inbox).
INQUIRY_TO_EMAIL=
# Verified sender on the Resend account, for example "Obordeleau <site@obordeleau.fr>".
INQUIRY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Phase 2, booking calendar and iCal sync
# ---------------------------------------------------------------------------

# Availability store. Server side only: the service role key bypasses RLS, so it
# must never carry a NEXT_PUBLIC_ prefix. Project settings, API, in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random path segment for the public feed served at
# /api/calendar/<ICAL_FEED_TOKEN>.ics, the single URL pasted into Airbnb and
# into Booking. Rotating it invalidates the URL both platforms hold.
ICAL_FEED_TOKEN=

# Where a direct booking is announced. Falls back to INQUIRY_TO_EMAIL.
BOOKINGS_TO_EMAIL=

# Direct Postgres connection, used only by `npm run test:sql`. Never read by
# the application: the site talks to PostgREST with the two keys above.
SUPABASE_DB_URL=

# Not an environment variable: the Airbnb export URL is a row in `ical_sources`,
# so adding Booking later is an insert rather than a deploy. The secret shared
# by the pg_cron schedule and the sync-ical Edge Function lives in the database
# too, in `sync_config`; setting SYNC_SECRET on the Edge Function overrides it.

# ---------------------------------------------------------------------------

# The owner's console at /admin. One password, no account and no address: there
# is one person who opens this and she knows who she is.
#
# This is the whole lock, so make it long. A passphrase of four or five unusual
# words is easier to keep and harder to guess than something short and clever:
#
#   openssl rand -base64 24
#
# Without it the console refuses to sign anyone in rather than falling back to
# something weaker, and an empty submission can never match an empty variable.
# Five wrong answers from one address within a quarter of an hour lock it for
# the next quarter of an hour.
ADMIN_PASSWORD=

# Signs the cookie that says the password was checked. A different secret from
# the password itself, never reused elsewhere, and at least 32 characters:
#
#   openssl rand -base64 48
#
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Phase 3 lot 4, the deposit
# ---------------------------------------------------------------------------

# Server side only, no NEXT_PUBLIC_ prefix, same discipline as the service role
# key. Without both of the first two the checkout is not offered at all and the
# booking flow falls back to the enquiry it had before: a card form that cannot
# take a card is worse than no card form.
STRIPE_SECRET_KEY=

# Signs the events Stripe posts to /api/stripe/webhook. Copy it from the
# endpoint you create in the Stripe dashboard, Developers, Webhooks, subscribed
# to payment_intent.succeeded and payment_intent.payment_failed. The webhook is
# what actually confirms a booking, so this is not optional in production.
STRIPE_WEBHOOK_SECRET=

# Public by nature: it identifies the account and can do nothing on its own.
# It is the one Stripe key the browser is given.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Not an environment variable: how many days before arrival the balance is
# taken is a row in pricing_config (deposit_charge_days_before_arrival, seeded
# to 14 by the lot 4 migration) and is editable from the console at /admin.
